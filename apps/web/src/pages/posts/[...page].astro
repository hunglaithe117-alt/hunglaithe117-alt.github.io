---
/** Post index — every published note, newest first, paginated. */
import type { GetStaticPaths, Page } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostRow from "@/components/PostRow.astro";
import { DEFAULT_LOCALE, postsPath, tagsPath, UI } from "@/lib/i18n";
import { getListingPosts, type Post } from "@/lib/posts";

export const getStaticPaths = (async ({ paginate }) => {
  return paginate(await getListingPosts(), { pageSize: 10 });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
}
const { page } = Astro.props;
const lang = DEFAULT_LOCALE;
const t = UI[lang];
const currentPage = page.currentPage;
const canonical = currentPage === 1 ? postsPath() : `${postsPath()}${currentPage}/`;
---

<BaseLayout
  lang={lang}
  title={
    currentPage === 1
      ? `${t.postsTitle} — ${t.siteTitle}`
      : `${t.postsTitle} · ${currentPage} — ${t.siteTitle}`
  }
  description={t.postsLead}
  canonical={canonical}
>
  <div data-pagefind-body>
    <header class="measure">
      <h1>{t.postsTitle}</h1>
      <p class="mt-3 text-text-muted">{t.postsLead}</p>
    </header>

    {page.data.length === 0 ? (
      <p class="mt-12 text-text-muted">{t.noPosts}</p>
    ) : (
      <ul class="post-list mt-10">
        {page.data.map((post) => (
          <PostRow post={post} />
        ))}
      </ul>
    )}

    {page.lastPage > 1 && (
      <nav class="mt-10 flex items-center justify-between text-sm" aria-label={t.postsTitle}>
        {page.url.prev ? (
          <a class="quiet-link inline-flex min-h-11 items-center" href={page.url.prev} rel="prev">
            ‹ {t.prevPost}
          </a>
        ) : (
          <span />
        )}
        {page.url.next ? (
          <a class="quiet-link inline-flex min-h-11 items-center" href={page.url.next} rel="next">
            {t.nextPost} ›
          </a>
        ) : (
          <span />
        )}
      </nav>
    )}

    <p class="mt-8 text-sm">
      <a href={tagsPath()}>{t.browseByTag}</a>
    </p>
  </div>
</BaseLayout>
