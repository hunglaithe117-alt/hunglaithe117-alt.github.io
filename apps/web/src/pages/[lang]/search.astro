---
/**
 * Search: the full-page Pagefind experience. The `<SearchBox />` island injects the
 * Pagefind Component UI bundle on the client and drives the inline input/summary/
 * results; the header trigger opens the same index as a modal.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SearchBox from "@blog/ui/SearchBox.vue";
import { LOCALES, postsPath, searchPath, tagsPath, UI, type Lang } from "@/lib/i18n";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = UI[lang];
const canonical = searchPath(lang);
const alternates = LOCALES.map((l) => ({ lang: l, path: searchPath(l) }));
---

<BaseLayout
  lang={lang}
  title={`${t.searchTitle} — ${t.siteTitle}`}
  description={t.searchLead}
  canonical={canonical}
  alternates={alternates}
>
  <div class="measure">
    <header data-pagefind-body>
      <h1>{t.searchTitle}</h1>
      <p class="mt-3 text-text-muted">{t.searchLead}</p>
    </header>

    <div class="mt-8" data-pagefind-ignore>
      <SearchBox
        client:visible
        mode="page"
        lang={lang}
        placeholder={t.searchPlaceholder}
        triggerLabel={t.search}
        loadingLabel={t.searchLoading}
        unavailableLabel={t.searchUnavailable}
        defaultMessage={t.searchDefaultMessage}
      />
    </div>

    <noscript>
      <p class="mt-6 text-sm text-text-muted">
        {t.searchNoJs}
        <a href={postsPath(lang)}>{t.allPosts}</a> · <a href={tagsPath(lang)}>{t.tags}</a>
      </p>
    </noscript>
  </div>
</BaseLayout>
