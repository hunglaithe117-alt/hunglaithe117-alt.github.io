---
/** Locale home: the site name, one line of introduction, then every published post. */
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostRow from "@/components/PostRow.astro";
import {
  absoluteUrl,
  homePath,
  HTML_LANG,
  LOCALES,
  postsPath,
  searchPath,
  UI,
  type Lang,
} from "@/lib/i18n";
import { getPostsByLang } from "@/lib/posts";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const site = Astro.site!;
const t = UI[lang];
const posts = await getPostsByLang(lang);
const canonical = homePath(lang);
const alternates = LOCALES.map((l) => ({ lang: l, path: homePath(l) }));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: t.siteTitle,
  description: t.siteDescription,
  url: absoluteUrl(site, canonical),
  inLanguage: HTML_LANG[lang],
};
---

<BaseLayout
  lang={lang}
  title={t.siteTitle}
  description={t.siteDescription}
  canonical={canonical}
  alternates={alternates}
  jsonLd={jsonLd}
  isHome={true}
>
  <div data-pagefind-body>
    <header class="measure">
      <h1>{t.siteTitle}</h1>
      <p class="mt-3 text-lg text-text-muted">{t.siteDescription}</p>
    </header>

    {posts.length === 0 ? (
      <p class="mt-12 text-text-muted">{t.noPosts}</p>
    ) : (
      <ul class="post-list measure mt-10">
        {posts.map((post) => (
          <PostRow post={post} />
        ))}
      </ul>
    )}

    <p class="mt-8 flex flex-wrap gap-x-4 text-sm">
      <a href={postsPath(lang)}>{t.allPosts}</a>
      <a href={searchPath(lang)}>{t.search}</a>
    </p>
  </div>
</BaseLayout>
