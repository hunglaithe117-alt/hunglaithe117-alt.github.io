---
/** Per-tag listing — posts carrying a tag, plus the per-tag feed link. */
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostRow from "@/components/PostRow.astro";
import { LOCALES, tagFeedPath, tagPath, tagsPath, UI, type Lang } from "@/lib/i18n";
import { collectTags, getPostsByLang } from "@/lib/posts";

export async function getStaticPaths() {
  const paths: { params: { lang: Lang; tag: string } }[] = [];
  for (const lang of LOCALES) {
    const posts = await getPostsByLang(lang);
    for (const tag of collectTags(posts)) {
      paths.push({ params: { lang, tag } });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const tag = Astro.params.tag as string;
const t = UI[lang];
const all = await getPostsByLang(lang);
const posts = all.filter((post) => post.data.tags.includes(tag));
const title = t.postsWithTag(tag);
const canonical = tagPath(lang, tag);
const alternates = LOCALES.map((l) => ({ lang: l, path: tagPath(l, tag) }));
const otherTags = collectTags(all).filter((other) => other !== tag);
---

<BaseLayout
  lang={lang}
  title={`${title} — ${t.siteTitle}`}
  description={`${t.tagsLead} ${title}.`}
  canonical={canonical}
  alternates={alternates}
>
  <div data-pagefind-body>
    <nav aria-label={t.tagsTitle} class="text-sm" data-pagefind-ignore>
      <a class="inline-flex min-h-11 items-center" href={tagsPath(lang)}>
        {t.tagsTitle}
      </a>
    </nav>

    <header class="measure">
      <h1>{title}</h1>
      <p class="mt-3 flex flex-wrap items-center gap-x-4 text-sm text-text-muted">
        <span>{t.tagCount(posts.length)}</span>{" "}
        <a href={tagFeedPath(lang, tag)} aria-label={`${t.tagFeedLabel}: ${tag}`}>
          {t.tagFeedLabel} (RSS)
        </a>
      </p>
    </header>

    <ul class="post-list measure mt-8">
      {posts.map((post) => (
        <PostRow post={post} />
      ))}
    </ul>

    {otherTags.length > 0 && (
      <section class="measure mt-14" aria-labelledby="other-tags" data-pagefind-ignore>
        <h2 id="other-tags" class="text-sm font-semibold text-text-muted">
          {t.tagFilters}
        </h2>
        <ul class="mt-1 flex list-none flex-wrap gap-x-4 p-0 text-sm">
          {otherTags.map((other) => (
            <li>
              <a
                class="inline-flex min-h-11 items-center text-text no-underline hover:text-link hover:underline hover:underline-offset-4"
                href={tagPath(lang, other)}
              >
                {other}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>
