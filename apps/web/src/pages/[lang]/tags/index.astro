---
/** Tag index (T3.3) — every tag for a locale with counts and a per-tag feed link. */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { LOCALES, tagFeedPath, tagPath, tagsPath, UI, type Lang } from "@/lib/i18n";
import { collectTags, getPostsByLang } from "@/lib/posts";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = UI[lang];
const posts = await getPostsByLang(lang);
const tags = collectTags(posts).map((tag) => ({
  tag,
  count: posts.filter((post) => post.data.tags.includes(tag)).length,
}));
const canonical = tagsPath(lang);
const alternates = LOCALES.map((l) => ({ lang: l, path: tagsPath(l) }));
---

<BaseLayout
  lang={lang}
  title={`${t.tagsTitle} — ${t.siteTitle}`}
  description={t.tagsLead}
  canonical={canonical}
  alternates={alternates}
>
  <div data-pagefind-body>
    <header class="measure" data-reveal style="--reveal-index:0">
      <h1>{t.tagsTitle}</h1>
      <p class="mt-4 text-lg text-text-muted">{t.tagsLead}</p>
    </header>

    {tags.length === 0 ? (
      <p class="mt-12 text-text-muted">{t.noTags}</p>
    ) : (
      <ul class="mt-10 grid list-none grid-cols-1 gap-4 p-0 tablet:grid-cols-2 desktop:grid-cols-3">
        {tags.map(({ tag, count }, i) => (
          <li
            class="flex items-center justify-between gap-4 rounded-lg border border-border bg-surface p-4"
            data-reveal
            style={`--reveal-index:${Math.min(i, 6)}`}
          >
            <a href={tagPath(lang, tag)} class="text-lg font-semibold no-underline">
              {tag}
            </a>
            <span class="flex items-center gap-3 text-sm text-text-muted">
              <span>{t.tagCount(count)}</span>
              <a
                href={tagFeedPath(lang, tag)}
                class="tag-chip"
                aria-label={`${t.tagFeedLabel}: ${tag}`}
              >
                RSS
              </a>
            </span>
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
