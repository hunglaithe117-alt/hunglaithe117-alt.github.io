---
/** Tag index — every tag for a locale, with its count and per-tag feed link. */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { LOCALES, tagFeedPath, tagPath, tagsPath, UI, type Lang } from "@/lib/i18n";
import { collectTags, getPostsByLang } from "@/lib/posts";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = UI[lang];
const posts = await getPostsByLang(lang);
const tags = collectTags(posts).map((tag) => ({
  tag,
  count: posts.filter((post) => post.data.tags.includes(tag)).length,
}));
const canonical = tagsPath(lang);
const alternates = LOCALES.map((l) => ({ lang: l, path: tagsPath(l) }));
---

<BaseLayout
  lang={lang}
  title={`${t.tagsTitle} — ${t.siteTitle}`}
  description={t.tagsLead}
  canonical={canonical}
  alternates={alternates}
>
  <div data-pagefind-body>
    <header class="measure">
      <h1>{t.tagsTitle}</h1>
      <p class="mt-3 text-text-muted">{t.tagsLead}</p>
    </header>

    {tags.length === 0 ? (
      <p class="mt-12 text-text-muted">{t.noTags}</p>
    ) : (
      <ul class="measure mt-8 list-none p-0">
        {tags.map(({ tag, count }) => (
          <li class="flex flex-wrap items-baseline justify-between gap-x-4 border-b border-border">
            <a
              class="inline-flex min-h-11 items-center text-text no-underline hover:text-link hover:underline hover:underline-offset-4"
              href={tagPath(lang, tag)}
            >
              {tag}
            </a>{" "}
            <span class="flex items-center gap-4 text-sm text-text-muted">
              <span>{t.tagCount(count)}</span>{" "}
              <a
                class="inline-flex min-h-11 items-center text-sm no-underline hover:underline hover:underline-offset-4"
                href={tagFeedPath(lang, tag)}
                aria-label={`${t.tagFeedLabel}: ${tag}`}
              >
                RSS
              </a>
            </span>
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
