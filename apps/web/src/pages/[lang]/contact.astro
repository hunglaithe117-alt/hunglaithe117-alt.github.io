---
/**
 * Contact (T3.3): static intro + the `<ContactForm />` Vue island. The island
 * POSTs to `/api/contact` (Phase 5); if the API is not reachable yet it falls
 * back to its honest "not connected" status rather than throwing.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactForm from "@blog/ui/ContactForm.vue";
import { contactPath, HTML_LANG, absoluteUrl, LOCALES, UI, type Lang } from "@/lib/i18n";
import { CONTACT } from "@/lib/pages-content";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = UI[lang];
const contact = CONTACT[lang];
const canonical = contactPath(lang);
const alternates = LOCALES.map((l) => ({ lang: l, path: contactPath(l) }));

const labels = {
  name: t.formName,
  email: t.formEmail,
  subject: t.formSubject,
  message: t.formMessage,
  required: t.formRequired,
  optional: t.formOptional,
  send: t.formSend,
  sending: t.formSending,
  nameRequired: t.formNameRequired,
  emailRequired: t.formEmailRequired,
  emailInvalid: t.formEmailInvalid,
  messageRequired: t.formMessageRequired,
  messageShort: t.formMessageShort,
  honeypot: t.formHoneypot,
  privacy: t.formPrivacy,
  received: t.formReceived,
  noBackend: t.formNoBackend,
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: t.contactTitle,
  url: absoluteUrl(Astro.site!, canonical),
  inLanguage: HTML_LANG[lang],
};
---

<BaseLayout
  lang={lang}
  title={`${t.contactTitle} — ${t.siteTitle}`}
  description={t.contactLead}
  canonical={canonical}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <div class="grid gap-12 desktop:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)]">
    <div data-pagefind-body>
      <header data-reveal style="--reveal-index:0">
        <h1>{t.contactTitle}</h1>
        <p class="mt-4 text-lg text-text-muted">{t.contactLead}</p>
      </header>

      <div class="measure mt-6">
        {contact.intro.map((paragraph) => (
          <p class="text-text-muted">{paragraph}</p>
        ))}
      </div>

      <section class="measure mt-10" aria-labelledby="expect">
        <h2 id="expect" class="text-lg">
          {t.contactExpectTitle}
        </h2>
        <ul class="mt-3 flex list-none flex-col gap-2 p-0 text-sm text-text-muted">
          {contact.expect.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>

      <p class="measure mt-8 text-sm">
        <span class="text-text-muted">{t.emailLabel}:</span>{" "}
        <a class="link-tap" href={`mailto:${contact.email}`}>
          {contact.email}
        </a>
        <!-- PLACEHOLDER: address is a stand-in until a real inbox exists. -->
        <span class="mt-1 block text-xs text-text-muted" data-placeholder="contact-email">
          {contact.emailNote}
        </span>
      </p>
    </div>

    <div
      class="rounded-xl border border-border bg-surface p-6 shadow-sm tablet:p-8"
      data-pagefind-ignore
    >
      <ContactForm client:visible lang={lang} labels={labels} endpoint="/api/contact" />
    </div>
  </div>
</BaseLayout>
