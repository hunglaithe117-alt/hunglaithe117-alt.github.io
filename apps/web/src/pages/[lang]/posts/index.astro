---
/** Post index — every published note for a locale, newest first. */
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostRow from "@/components/PostRow.astro";
import { LOCALES, postsPath, tagsPath, UI, type Lang } from "@/lib/i18n";
import { getPostsByLang } from "@/lib/posts";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = UI[lang];
const posts = await getPostsByLang(lang);
const canonical = postsPath(lang);
const alternates = LOCALES.map((l) => ({ lang: l, path: postsPath(l) }));
---

<BaseLayout
  lang={lang}
  title={`${t.postsTitle} — ${t.siteTitle}`}
  description={t.postsLead}
  canonical={canonical}
  alternates={alternates}
>
  <div data-pagefind-body>
    <header class="measure">
      <h1>{t.postsTitle}</h1>
      <p class="mt-3 text-text-muted">{t.postsLead}</p>
    </header>

    {posts.length === 0 ? (
      <p class="mt-12 text-text-muted">{t.noPosts}</p>
    ) : (
      <ul class="post-list measure mt-10">
        {posts.map((post) => (
          <PostRow post={post} />
        ))}
      </ul>
    )}

    <p class="mt-8 text-sm">
      <a href={tagsPath(lang)}>{t.browseByTag}</a>
    </p>
  </div>
</BaseLayout>
