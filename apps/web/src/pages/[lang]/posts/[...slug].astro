---
/**
 * Post page: title, date, reading time, tags as plain links, the rendered MDX prose
 * marked with `data-pagefind-body`, a quiet TOC (a `<details>` on phone, a sticky rail
 * on desktop), prev/next, and related notes as a dated list.
 */
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostRow from "@/components/PostRow.astro";
import PrevNext from "@/components/PrevNext.astro";
import Toc from "@/components/Toc.astro";
import { SITE_AUTHOR } from "@/consts";
import { absoluteUrl, HTML_LANG, postPath, tagPath, UI, type Lang } from "@/lib/i18n";
import {
  getPostsByLang,
  getPublishedPosts,
  getTranslations,
  readingTimeOf,
  slugOf,
  type Post,
} from "@/lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { lang: post.data.lang, slug: slugOf(post) },
    props: { post },
  }));
}

interface Props {
  post: Post;
}
const { post } = Astro.props;
const lang = post.data.lang as Lang;
const site = Astro.site!;
const t = UI[lang];
const slug = slugOf(post);
const canonical = postPath(lang, slug);

const { Content, headings } = await render(post);
const translations = await getTranslations(post.data.translationKey);
const alternates = translations.map((p) => ({
  lang: p.data.lang,
  path: postPath(p.data.lang, slugOf(p)),
}));

const dateFormatter = new Intl.DateTimeFormat(lang, { dateStyle: "long" });
const dateIso = post.data.date.toISOString();
const readingMinutes = readingTimeOf(post);
const coverUrl = post.data.cover ? absoluteUrl(site, post.data.cover) : undefined;

// Prev/next within the same locale: newest first, so "previous" is the older note.
const siblings = await getPostsByLang(lang);
const index = siblings.findIndex((p) => p.id === post.id);
const older = index >= 0 ? siblings[index + 1] : undefined;
const newer = index > 0 ? siblings[index - 1] : undefined;
const toNav = (p?: Post) => (p ? { href: postPath(lang, slugOf(p)), title: p.data.title } : null);

// Related: other posts sharing at least one tag, most overlap first.
const related = siblings
  .filter((p) => p.id !== post.id)
  .map((p) => ({
    post: p,
    shared: p.data.tags.filter((tag) => post.data.tags.includes(tag)).length,
  }))
  .filter((entry) => entry.shared > 0)
  .sort((a, b) => b.shared - a.shared)
  .slice(0, 3)
  .map((entry) => entry.post);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: dateIso,
  dateModified: dateIso,
  inLanguage: HTML_LANG[lang],
  author: { "@type": "Person", name: SITE_AUTHOR },
  mainEntityOfPage: absoluteUrl(site, canonical),
  url: absoluteUrl(site, canonical),
  keywords: post.data.tags,
  ...(coverUrl ? { image: coverUrl } : {}),
};
---

<BaseLayout
  lang={lang}
  title={`${post.data.title} — ${t.siteTitle}`}
  description={post.data.description}
  canonical={canonical}
  alternates={alternates}
  image={coverUrl}
  jsonLd={jsonLd}
  ogType="article"
>
  <div class="article-layout">
    <article class="article-main" data-pagefind-body>
      <header class="measure">
        <h1>{post.data.title}</h1>
        <p class="mt-3 text-sm text-text-muted" data-pagefind-ignore>
          <time datetime={dateIso}>{dateFormatter.format(post.data.date)}</time>
          <span aria-hidden="true"> · </span>
          <span>{t.readingTime(readingMinutes)}</span>
        </p>
        {post.data.tags.length > 0 && (
          <ul class="mt-1 flex list-none flex-wrap gap-x-3 p-0 text-sm" data-pagefind-ignore>
            {post.data.tags.map((tag) => (
              <li>
                <a
                  class="inline-flex min-h-9 items-center text-text-muted no-underline hover:text-link hover:underline hover:underline-offset-4"
                  href={tagPath(lang, tag)}
                >
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )}
      </header>

      <div class="mt-6">
        <Toc headings={headings} title={t.tocTitle} variant="inline" />
      </div>

      <div class="prose mt-8">
        <Content />
      </div>

      <PrevNext
        prev={toNav(older)}
        next={toNav(newer)}
        prevLabel={t.prevPost}
        nextLabel={t.nextPost}
      />
    </article>

    <aside>
      <Toc headings={headings} title={t.tocTitle} variant="rail" />
    </aside>
  </div>

  {related.length > 0 && (
    <section class="measure mt-16" aria-labelledby="related" data-pagefind-ignore>
      <h2 id="related" class="text-sm font-semibold text-text-muted">
        {t.relatedPosts}
      </h2>
      <ul class="post-list mt-2">
        {related.map((p) => (
          <PostRow post={p} />
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
