---
/**
 * About page. Copy comes from `lib/pages-content.ts`; the contact block lists only
 * the links the owner has actually supplied in `lib/site.ts`, one per line.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { aboutPath, absoluteUrl, DEFAULT_LOCALE, HTML_LANG, UI } from "@/lib/i18n";
import { ABOUT } from "@/lib/pages-content";
import { contactLinks, type ContactLink } from "@/lib/site";

const lang = DEFAULT_LOCALE;
const t = UI[lang];
const canonical = aboutPath();
const contacts = contactLinks();

/** Readable text for a contact link: the address for email, the bare host for the web. */
function contactText(link: ContactLink): string {
  if (link.href.startsWith("mailto:")) return link.href.slice("mailto:".length);
  return link.href.replace(/^https?:\/\//, "").replace(/\/$/, "");
}

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: t.aboutTitle,
  url: absoluteUrl(Astro.site!, canonical),
  inLanguage: HTML_LANG[lang],
};
---

<BaseLayout
  lang={lang}
  title={`${t.aboutTitle} — ${t.siteTitle}`}
  description={ABOUT.join(" ")}
  canonical={canonical}
  jsonLd={jsonLd}
>
  <div class="measure" data-pagefind-body>
    <header>
      <h1>{t.aboutTitle}</h1>
    </header>

    {contacts.length > 0 && (
      <section class="mt-8" aria-labelledby="contact" data-pagefind-ignore>
        <h2 id="contact" class="text-sm font-semibold text-text-muted">
          {t.contact}
        </h2>
        <ul class="mt-1 list-none p-0 text-sm">
          {contacts.map((link) => (
            <li class="flex flex-wrap items-baseline gap-x-3">
              <span class="w-20 shrink-0 text-text-muted">{link.label}</span>
              <a href={link.href} rel="me noopener">
                {contactText(link)}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="prose mt-10">
      {ABOUT.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </div>
</BaseLayout>
