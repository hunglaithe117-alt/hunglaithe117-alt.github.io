---
/**
 * 404 page. Every site route is unprefixed (`/`, `/posts/`, …), so a single root
 * `404.html` serves anything unmatched; copy is the default-locale (English) text.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { DEFAULT_LOCALE, homePath, UI } from "@/lib/i18n";

const lang = DEFAULT_LOCALE;
const t = UI[lang];
---

<BaseLayout
  lang={lang}
  title={`${t.notFoundTitle} — ${t.siteTitle}`}
  description={t.notFoundBody}
  canonical="/404"
>
  <div class="measure py-4">
    <p class="text-sm text-text-muted">404</p>
    <h1 class="mt-2">{t.notFoundTitle}</h1>
    <p class="mt-4 text-text-muted">{t.notFoundBody}</p>
    <p class="mt-8">
      <a href={homePath()}>{t.notFoundCta}</a>
    </p>
  </div>
</BaseLayout>
