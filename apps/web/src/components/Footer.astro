---
/**
 * Site footer: one quiet line. © year and name, then the feed, search and any
 * contact links the owner has supplied. Excluded from the Pagefind index.
 */
import { contactLinks } from "@/lib/site";
import { homePath, searchPath, UI, type Lang } from "@/lib/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = UI[lang];
const year = new Date().getFullYear();
const contacts = contactLinks();

const linkClass = "quiet-link inline-flex min-h-11 items-center text-sm";
---

<footer class="mt-20 border-t border-border" data-pagefind-ignore>
  <div class="container-content flex flex-wrap items-center gap-x-5 gap-y-1 py-4 text-sm text-text-muted">
    <p class="flex items-center gap-1.5">
      <span>© {year}</span>
      <a class={linkClass} href={homePath(lang)}>
        {t.siteTitle}
      </a>
    </p>
    <a class={linkClass} href={`/${lang}/rss.xml`}>
      {t.rssFeed}
    </a>
    <a class={linkClass} href={searchPath(lang)}>
      {t.search}
    </a>
    {contacts.map((link) => (
      <a class={linkClass} href={link.href} rel="me noopener">
        {link.label}
      </a>
    ))}
  </div>
</footer>
