---
/**
 * Site footer (DESIGN-SYSTEM §6.2): stacked on phone, 2-col on tablet, 4-col + bar on
 * desktop. Excluded from the Pagefind index (chrome, not prose).
 */
import {
  UI,
  HTML_LANG,
  LOCALE_LABEL,
  LOCALES,
  homePath,
  postsPath,
  tagsPath,
  type Lang,
} from "@/lib/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = UI[lang];
const year = new Date().getFullYear();

// No uppercase/tracking — §1.3 forbids uppercasing Vietnamese labels.
const headingClass = "text-xs font-semibold text-text-muted";
const linkClass =
  "inline-flex min-h-11 items-center text-text no-underline transition-colors duration-fast ease-standard hover:text-link-hover";
---

<footer class="mt-16 border-t border-border bg-surface" data-pagefind-ignore>
  <div class="container-content grid gap-8 py-12 tablet:grid-cols-2 desktop:grid-cols-4">
    <div class="desktop:col-span-1">
      <h2 class={headingClass}>{t.siteTitle}</h2>
      <p class="mt-3 max-w-[38ch] text-sm text-text-muted">{t.siteDescription}</p>
    </div>

    <nav aria-labelledby="footer-browse">
      <h2 id="footer-browse" class={headingClass}>
        {t.menu}
      </h2>
      <ul class="mt-3 flex list-none flex-col p-0">
        <li>
          <a class={linkClass} href={homePath(lang)}>
            {t.home}
          </a>
        </li>
        <li>
          <a class={linkClass} href={postsPath(lang)}>
            {t.posts}
          </a>
        </li>
        <li>
          <a class={linkClass} href={tagsPath(lang)}>
            {t.tags}
          </a>
        </li>
        <li>
          <a class={linkClass} href={`/${lang}/about/`}>
            {t.about}
          </a>
        </li>
        <li>
          <a class={linkClass} href={`/${lang}/contact/`}>
            {t.contact}
          </a>
        </li>
      </ul>
    </nav>

    <nav aria-labelledby="footer-feeds">
      <h2 id="footer-feeds" class={headingClass}>
        {t.feedsTitle}
      </h2>
      <ul class="mt-3 flex list-none flex-col p-0">
        <li>
          <a class={linkClass} href={`/${lang}/rss.xml`}>
            {t.rssFeed}
          </a>
        </li>
        <li>
          <a class={linkClass} href={`/${lang}/feed.json`}>
            {t.jsonFeed}
          </a>
        </li>
        <li>
          <a class={linkClass} href={`/${lang}/search/`}>
            {t.search}
          </a>
        </li>
      </ul>
    </nav>

    <nav aria-labelledby="footer-lang">
      <h2 id="footer-lang" class={headingClass}>
        {t.languageSwitcher}
      </h2>
      <ul class="mt-3 flex list-none flex-col p-0">
        {LOCALES.map((l) => (
          <li>
            <a
              class={linkClass}
              href={homePath(l)}
              hreflang={HTML_LANG[l]}
              lang={HTML_LANG[l]}
              aria-current={l === lang ? "true" : undefined}
            >
              {LOCALE_LABEL[l]}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="container-content border-t border-border py-6 text-xs text-text-muted">
    © {year} <span>{t.siteTitle}</span>
  </div>
</footer>
