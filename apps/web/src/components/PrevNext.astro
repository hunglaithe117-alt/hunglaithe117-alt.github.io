---
/**
 * Previous / next post navigation: two plain links, label above title. Direction is
 * carried by the label text, never by an arrow alone.
 */
interface NavItem {
  href: string;
  title: string;
}

interface Props {
  prev?: NavItem | null;
  next?: NavItem | null;
  prevLabel: string;
  nextLabel: string;
}
const { prev, next, prevLabel, nextLabel } = Astro.props;
const hasAny = Boolean(prev || next);
---

{hasAny && (
  <nav
    class="mt-14 flex flex-col gap-2 border-t border-border pt-4 text-sm tablet:flex-row tablet:justify-between tablet:gap-8"
    aria-label={`${prevLabel} / ${nextLabel}`}
    data-pagefind-ignore
  >
    {prev ? (
      <a class="group flex min-h-11 flex-col justify-center no-underline" href={prev.href}>
        <span class="text-text-muted">{prevLabel}</span>
        <span class="text-text group-hover:text-link group-hover:underline group-hover:underline-offset-4">
          {prev.title}
        </span>
      </a>
    ) : (
      <span aria-hidden="true"></span>
    )}

    {next ? (
      <a
        class="group flex min-h-11 flex-col justify-center no-underline tablet:items-end"
        href={next.href}
      >
        <span class="text-text-muted">{nextLabel}</span>
        <span class="text-text group-hover:text-link group-hover:underline group-hover:underline-offset-4">
          {next.title}
        </span>
      </a>
    ) : (
      <span aria-hidden="true"></span>
    )}
  </nav>
)}
