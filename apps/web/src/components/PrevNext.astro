---
/**
 * Previous / next post navigation (T3.3). Directional labels use an arrow glyph plus
 * a text label so meaning never rests on the arrow alone (§5). One column on phone,
 * two columns from tablet up.
 */
interface NavItem {
  href: string;
  title: string;
}

interface Props {
  prev?: NavItem | null;
  next?: NavItem | null;
  prevLabel: string;
  nextLabel: string;
}
const { prev, next, prevLabel, nextLabel } = Astro.props;
const hasAny = Boolean(prev || next);
---

{hasAny && (
  <nav
    class="mt-16 grid gap-4 border-t border-border pt-8 tablet:grid-cols-2"
    aria-label={`${prevLabel} / ${nextLabel}`}
    data-pagefind-ignore
  >
    {prev ? (
      <a
        href={prev.href}
        class="group flex min-h-15 flex-col justify-center gap-1 rounded-lg border border-border bg-surface p-4 no-underline shadow-xs transition-transform duration-fast ease-standard hover:-translate-y-px"
      >
        <span class="flex items-center gap-1.5 text-xs font-semibold text-text-muted">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            aria-hidden="true"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M19 12H5M12 19l-7-7 7-7" />
          </svg>
          {prevLabel}
        </span>
        <span class="text-base font-semibold text-text transition-colors duration-fast group-hover:text-link">
          {prev.title}
        </span>
      </a>
    ) : (
      <span aria-hidden="true"></span>
    )}

    {next ? (
      <a
        href={next.href}
        class="group flex min-h-15 flex-col justify-center gap-1 rounded-lg border border-border bg-surface p-4 text-end no-underline shadow-xs transition-transform duration-fast ease-standard hover:-translate-y-px tablet:items-end"
      >
        <span class="flex items-center gap-1.5 text-xs font-semibold text-text-muted">
          {nextLabel}
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            aria-hidden="true"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </span>
        <span class="text-base font-semibold text-text transition-colors duration-fast group-hover:text-link">
          {next.title}
        </span>
      </a>
    ) : (
      <span aria-hidden="true"></span>
    )}
  </nav>
)}
