---
/**
 * Responsive primary navigation (DESIGN-SYSTEM §6.2):
 *  - desktop: full inline <nav>
 *  - phone/tablet: a single Vue drawer island (`NavDrawer`, client:visible)
 *  - no-JS: a <details> fallback under <noscript>
 */
import NavDrawer from "@blog/ui/NavDrawer.vue";
import { UI, type Lang } from "@/lib/i18n";

interface NavLink {
  href: string;
  label: string;
}
interface Props {
  lang: Lang;
  links: NavLink[];
  switchHref: string;
  switchLabel: string;
}
const { lang, links, switchHref, switchLabel } = Astro.props;
const t = UI[lang];

const itemClass =
  "inline-flex min-h-11 items-center rounded-md px-3 text-sm text-text no-underline transition-colors duration-fast ease-standard hover:bg-surface";
---

<nav class="hidden items-center gap-1 desktop:flex" aria-label="Primary">
  {links.map((link) => (
    <a href={link.href} class={itemClass}>
      {link.label}
    </a>
  ))}
  {/* The language switch lives in BaseLayout (`<LanguageSwitcher />`) so it sits in
      the same control cluster at every breakpoint — no duplicate control here. */}
</nav>

<div class="desktop:hidden">
  <NavDrawer
    client:visible
    links={links}
    labels={{
      menu: t.menu,
      open: t.openMenu,
      close: t.closeMenu,
      language: t.languageSwitcher,
    }}
    switchHref={switchHref}
    switchLabel={switchLabel}
  />
</div>

<noscript>
  <details class="desktop:hidden">
    <summary class={itemClass} style="border: 1px solid var(--color-border-strong)">
      {t.menu}
    </summary>
    <nav aria-label="Primary" class="mt-2">
      <ul class="flex flex-col gap-1">
        {links.map((link) => (
          <li>
            <a href={link.href} class={itemClass}>
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <a href={switchHref} class={itemClass}>
            {switchLabel}
          </a>
        </li>
      </ul>
    </nav>
  </details>
</noscript>
