---
/**
 * Primary navigation: plain inline links from desktop up, and a single small menu
 * control below that. The menu is the existing `NavDrawer` island (native <dialog>,
 * so focus handling and Esc come from the platform); a `<details>` fallback covers
 * the no-JS case.
 */
import NavDrawer from "@blog/ui/NavDrawer.vue";
import { UI, type Lang } from "@/lib/i18n";

interface NavLink {
  href: string;
  label: string;
}
interface Props {
  lang: Lang;
  links: NavLink[];
  /** Owner-supplied contact links; empty when nothing is configured. */
  contacts: NavLink[];
}
const { lang, links, contacts } = Astro.props;
const t = UI[lang];

const itemClass = "quiet-link inline-flex min-h-11 items-center text-sm";

/** Trailing-slash-insensitive: `/posts` and `/posts/` resolve to one target. */
const normalize = (path: string) => path.replace(/\/+$/, "") || "/";
const pathname = normalize(Astro.url.pathname);
const isCurrent = (href: string) => {
  const target = normalize(href);
  if (target === pathname) return true;
  // An article keeps its locale in the URL, so the unprefixed Posts item stays
  // current on `/[lang]/posts/<slug>`.
  if (target === "/posts" && /^\/(en|vi)\/posts\//.test(pathname)) return true;
  // A bare `/` target must not prefix-match every path.
  return target !== "/" && pathname.startsWith(`${target}/`);
};
---

<nav class="hidden items-center gap-5 desktop:flex" aria-label="Primary">
  {links.map((link) => (
    <a href={link.href} class={itemClass} aria-current={isCurrent(link.href) ? "page" : undefined}>
      {link.label}
    </a>
  ))}
</nav>

<div class="desktop:hidden">
  <NavDrawer
    client:visible
    links={links}
    contacts={contacts}
    labels={{
      menu: t.menu,
      open: t.openMenu,
      close: t.closeMenu,
    }}
  />
</div>

<noscript>
  <details class="desktop:hidden">
    <summary class={`${itemClass} cursor-pointer`}>{t.menu}</summary>
    <nav aria-label="Primary" class="mt-2">
      <ul class="flex flex-col">
        {links.map((link) => (
          <li>
            <a href={link.href} class={itemClass}>
              {link.label}
            </a>
          </li>
        ))}
        {contacts.map((link) => (
          <li>
            <a href={link.href} class={itemClass} rel="me noopener">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </details>
</noscript>
