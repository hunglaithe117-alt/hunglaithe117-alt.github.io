---
/**
 * Article table of contents (DESIGN-SYSTEM §6.2). Two presentations, chosen by
 * `variant` so the page never renders both:
 *  - `inline`: an always-visible `<details>` at the top of the article (phone/tablet)
 *  - `rail`:   a sticky right-hand rail (desktop only, hidden below `lg`)
 * The caller supplies headings from `render(post)`; we keep h2 + h3 only.
 */
export interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: TocHeading[];
  title: string;
  /** Minimum number of headings before the TOC is worth showing. */
  threshold?: number;
  variant?: "inline" | "rail";
}
const { headings, title, threshold = 3, variant = "inline" } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
const show = items.length >= threshold;
---

{show && variant === "inline" && (
  <details class="toc-phone mb-8 rounded-lg border border-border bg-surface shadow-xs">
    <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-2 px-4 py-3 text-sm font-semibold text-text [&::-webkit-details-marker]:hidden">
      {title}
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="toc-chevron shrink-0 text-text-muted"
      >
        <path d="m6 9 6 6 6-6" />
      </svg>
    </summary>
    <nav aria-label={title} class="border-t border-border px-4 pb-4 pt-3">
      <ol class="flex list-none flex-col gap-1 p-0 text-sm">
        {items.map((h) => (
          <li class={h.depth === 3 ? "ps-4" : ""}>
            <a
              href={`#${h.slug}`}
              class="inline-flex min-h-9 items-center text-text-muted no-underline transition-colors duration-fast ease-standard hover:text-link"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </details>
)}

{show && variant === "rail" && (
  <nav class="toc" aria-label={title}>
    {/* No uppercase/tracking: §1.3 forbids uppercasing Vietnamese labels. */}
    <p class="text-xs font-semibold text-text-muted">{title}</p>
    <ol class="mt-3 flex list-none flex-col gap-1.5 border-s border-border p-0 ps-4 text-sm">
      {items.map((h) => (
        <li class={h.depth === 3 ? "ps-3" : ""}>
          <a
            href={`#${h.slug}`}
            class="inline-flex min-h-8 items-center text-text-muted no-underline transition-colors duration-fast ease-standard hover:text-link"
          >
            {h.text}
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}
