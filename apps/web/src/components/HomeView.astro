---
/** Shared home post-list view used by `/` (English default) and `/[lang]/`. */
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostRow from "@/components/PostRow.astro";
import { absoluteUrl, homePath, HTML_LANG, LOCALES, UI, type Lang } from "@/lib/i18n";
import { getPostsByLang } from "@/lib/posts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const site = Astro.site!;
const t = UI[lang];
const posts = await getPostsByLang(lang);
const canonical = homePath(lang);
const alternates = LOCALES.map((l) => ({ lang: l, path: homePath(l) }));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: t.siteTitle,
  description: t.siteDescription,
  url: absoluteUrl(site, canonical),
  inLanguage: HTML_LANG[lang],
};
---

<BaseLayout
  lang={lang}
  title={t.siteTitle}
  description={t.siteDescription}
  canonical={canonical}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <div data-pagefind-body>
    <h1 class="sr-only">{t.postsTitle}</h1>

    {posts.length === 0 ? (
      <p class="text-text-muted">{t.noPosts}</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <PostRow post={post} />
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
