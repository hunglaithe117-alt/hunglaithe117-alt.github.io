---
/**
 * Inline per-post language switch: a plain text link to each published translation,
 * separated by ` · `. Renders nothing when the post has no other locale.
 *
 * Plain Astro, not a Vue island: there is no interactivity to hydrate, and the link
 * keeps working with JS disabled.
 */
import { HTML_LANG, LOCALE_LABEL, UI, type Lang } from "@/lib/i18n";

interface Props {
  /** Locale the visitor is reading (for aria labels). */
  lang: Lang;
  /** Published translations of this post, excluding the current locale. */
  translations: { lang: Lang; path: string }[];
  class?: string;
}
const { lang, translations, class: className = "" } = Astro.props;
---

{translations.length > 0 && (
  <>
    {translations.map((item) => (
      <>
        <span aria-hidden="true"> · </span>
        {/* The base `a` rule supplies the underline and `--color-link-hover`;
              `text-text-muted` keeps the link subordinate to the date. `min-h-11`
              gives a 44px touch target and `-my-3` collapses its margin box so the
              meta line does not grow. */}
        <a
          href={item.path}
          hreflang={HTML_LANG[item.lang]}
          lang={HTML_LANG[item.lang]}
          aria-label={UI[lang].readInLanguage(LOCALE_LABEL[item.lang])}
          class={`post-lang-switch inline-flex min-h-11 items-center -my-3 text-text-muted hover:text-link-hover ${className}`}
        >
          {LOCALE_LABEL[item.lang]}
        </a>
      </>
    ))}
  </>
)}
