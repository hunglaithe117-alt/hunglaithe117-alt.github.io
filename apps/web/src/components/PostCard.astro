---
/**
 * Post summary card used on the home/archive lists.
 * Container-query driven so the same card works in any grid width (§6.5); the cover
 * renders through `astro:assets` for hashed, responsive, CLS-free images (§6.6).
 */
import { Image } from "astro:assets";
import { coverImage } from "@/lib/images";
import { postPath, UI } from "@/lib/i18n";
import { readingTimeOf, slugOf, type Post } from "@/lib/posts";

interface Props {
  post: Post;
  /** First card in a list is the likely LCP candidate → eager + high priority. */
  eager?: boolean;
}
const { post, eager = false } = Astro.props;
const t = UI[post.data.lang];
const href = postPath(post.data.lang, slugOf(post));
const dateFormatter = new Intl.DateTimeFormat(post.data.lang, { dateStyle: "long" });
const dateIso = post.data.date.toISOString();
const cover = coverImage(post.data.cover);
---

<article class="post-card flex h-full flex-col gap-3 rounded-lg border border-border bg-surface p-4 shadow-xs transition-transform duration-fast ease-standard hover:-translate-y-px focus-within:-translate-y-px">
  {cover && (
    <Image
      src={cover}
      alt=""
      widths={[360, 480, 640, 1024]}
      sizes="(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw"
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      class="aspect-[16/9] w-full rounded-md object-cover"
    />
  )}
  <h3 class="text-lg">
    <a
      href={href}
      class="text-text transition-colors duration-fast ease-standard hover:text-link-hover"
    >
      {post.data.title}
    </a>
  </h3>
  <p class="text-sm text-text-muted">{post.data.description}</p>
  <p class="mt-auto flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-text-muted">
    <time datetime={dateIso}>{dateFormatter.format(post.data.date)}</time>
    <span aria-hidden="true">·</span>
    <span>{t.readingTime(readingTimeOf(post))}</span>
  </p>
</article>
