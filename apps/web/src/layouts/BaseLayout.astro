---
/**
 * Base layout: document head/SEO, feed autodiscovery, skip-link, the plain header
 * (site name left, links and controls right), and the footer. Every page composes it.
 */
import "@/styles/global.css";
import atkLatin from "@fontsource-variable/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-wght-normal.woff2?url";
import Footer from "@/components/Footer.astro";
import BackToTop from "@/components/BackToTop.astro";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import Nav from "@/components/Nav.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import SearchBox from "@blog/ui/SearchBox.vue";
import {
  absoluteUrl,
  DEFAULT_LOCALE,
  homePath,
  HTML_LANG,
  LOCALES,
  LOCALE_LABEL,
  postsPath,
  tagsPath,
  UI,
  type Lang,
} from "@/lib/i18n";
import { contactLinks } from "@/lib/site";

interface Alternate {
  lang: Lang;
  /** Root-relative path of this locale's variant. */
  path: string;
}
interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Root-relative canonical path. */
  canonical: string;
  alternates?: Alternate[];
  /** Absolute URL of the social preview image. */
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Open Graph object type; only a post page is an `article`. */
  ogType?: "website" | "article";
}

const {
  lang,
  title,
  description,
  canonical,
  alternates = [{ lang, path: homePath(lang) }],
  image,
  jsonLd,
  ogType = "website",
} = Astro.props;

const site = Astro.site!;
const t = UI[lang];
/**
 * Cloudflare Web Analytics is opt-in: a build with `PUBLIC_ANALYTICS_TOKEN` set emits
 * the beacon, and a build without it emits nothing. Development builds never emit it,
 * so local traffic cannot land in the dashboard.
 */
const analyticsToken = import.meta.env.PROD ? import.meta.env.PUBLIC_ANALYTICS_TOKEN : undefined;
const canonicalUrl = absoluteUrl(site, canonical);
const ogImage = image ?? absoluteUrl(site, "/og-default.png");
const rssHref = absoluteUrl(site, `/${lang}/rss.xml`);
const jsonFeedHref = absoluteUrl(site, `/${lang}/feed.json`);
const jsonLdNodes = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const jsonLdPayload = jsonLdNodes.length === 1 ? jsonLdNodes[0] : jsonLdNodes;

const otherLang = LOCALES.find((l) => l !== lang)!;
const otherAlt = alternates.find((a) => a.lang === otherLang);
const switchHref = otherAlt?.path ?? homePath(otherLang);
const defaultAlt = alternates.find((a) => a.lang === DEFAULT_LOCALE) ?? alternates[0]!;

const navLinks = [
  { href: postsPath(lang), label: t.posts },
  { href: tagsPath(lang), label: t.tags },
  { href: `/${lang}/about/`, label: t.about },
];
const contacts = contactLinks();
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- hreflang alternates + x-default -->
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={HTML_LANG[alt.lang]} href={absoluteUrl(site, alt.path)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(site, defaultAlt.path)} />

    <!-- Feed autodiscovery: RSS 2.0 + JSON Feed -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${t.siteTitle} — RSS`}
      href={rssHref}
    />
    <link
      rel="alternate"
      type="application/feed+json"
      title={`${t.siteTitle} — JSON Feed`}
      href={jsonFeedHref}
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <!-- Preload Latin normal weight; Vietnamese subset loads via unicode-range -->
    <link rel="preload" href={atkLatin} as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fcfcf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151411" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={t.siteTitle} />
    <meta property="og:locale" content={HTML_LANG[lang].replace("-", "_")} />
    {LOCALES.filter((l) => l !== lang).map((l) => (
      <meta property="og:locale:alternate" content={HTML_LANG[l].replace("-", "_")} />
    ))}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLdNodes.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLdPayload)} />
    )}

    <!-- Apply stored theme before first paint to prevent flash. -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          if (stored === "light" || stored === "dark") {
            document.documentElement.dataset.theme = stored;
          }
        } catch {
          /* ignore */
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">
      {t.skipToContent}
    </a>

    <header class="site-header" data-pagefind-ignore>
      {/* Phone/tablet: a wrapped flex row — site name, then controls, menu last.
          Desktop: a 3-slot grid (`1fr auto 1fr`) so the primary links sit on the
          page centre, not on the space left over between name and controls. The
          inner wrapper collapses with `contents` so its two children become the
          middle and right slots. */}
      <div class="container-content flex flex-wrap items-center justify-between gap-x-6 gap-y-1 py-2 desktop:grid desktop:grid-cols-[1fr_auto_1fr] desktop:justify-normal">
        <a
          class="site-name justify-self-start"
          href={homePath(lang)}
          aria-current={Astro.url.pathname.replace(/\/+$/, "") === `/${lang}` ? "page" : undefined}
        >
          {t.siteTitle}
        </a>

        <div class="flex items-center gap-1 desktop:contents">
          {/* Menu last on phone, its own slot on desktop (where the links are inline). */}
          <div class="order-last desktop:order-none">
            <Nav
              lang={lang}
              links={navLinks}
              contacts={contacts}
              switchHref={switchHref}
              switchLabel={LOCALE_LABEL[otherLang]}
            />
          </div>

          <div class="flex items-center gap-1 desktop:justify-self-end">
            <SearchBox
              client:load
              lang={lang}
              triggerLabel={t.search}
              placeholder={t.searchPlaceholder}
              loadingLabel={t.searchLoading}
              unavailableLabel={t.searchUnavailable}
              defaultMessage={t.searchDefaultMessage}
            />

            <LanguageSwitcher lang={lang} target={otherLang} href={switchHref} variant="compact" />

            <ThemeToggle lang={lang} />
          </div>
        </div>
      </div>
    </header>

    <main id="main" class="container-content w-full flex-1 py-10 desktop:py-14">
      <slot />
    </main>

    <Footer lang={lang} />

    <BackToTop lang={lang} />

    {analyticsToken && (
      <script
        is:inline
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      />
    )}
  </body>
</html>
