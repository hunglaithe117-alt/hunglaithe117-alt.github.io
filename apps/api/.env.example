# apps/api container environment (T5.1) — PLACEHOLDERS ONLY, never real values.
# Copy to `.env` (git-ignored) for local `go run ./cmd/server`.
# In production these are supplied by the Cloudflare Container runtime, not committed.

PORT=8080
ENVIRONMENT=development
# Comma-separated CORS allowlist; wildcard "*" is rejected (T5.5).
ALLOWED_ORIGINS=http://localhost:4321,http://localhost:8787
# Request body cap in bytes (T5.4 abuse guard).
MAX_BODY_BYTES=16384
RATE_LIMIT_PER_MINUTE=1

# D1 access over the Cloudflare REST API (the container cannot use Worker bindings).
CLOUDFLARE_ACCOUNT_ID=<ACCOUNT_ID>
D1_DATABASE_ID=<D1_DATABASE_ID>
D1_API_TOKEN=<D1_API_TOKEN>
D1_API_BASE_URL=https://api.cloudflare.com/client/v4

# Email Sending notification targets + optional dedicated token.
EMAIL_API_TOKEN=<EMAIL_API_TOKEN>
CONTACT_TO=owner@example.com
CONTACT_FROM=no-reply@example.com
# Pepper for stored IP hashes; supplied via --secrets-file in production.
IP_HASH_SALT=dev-only-salt
