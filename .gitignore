# ---------------------------------------------------------------------------
# Secrets — never commit real values.
#   Source: SOLUTION.md §E; TOOLCHAIN-VERIFIED.md §7; plan README.md §7.
#   `.env.example` / `.dev.vars.example` are placeholders and stay tracked.
# ---------------------------------------------------------------------------
.env
.env*
!.env.example
.dev.vars
.dev.vars*
!.dev.vars.example
secrets.env
secrets.json
*.pem
*.key

# ---------------------------------------------------------------------------
# Build output / caches.
#   `.cloudflare/` is `cf build` output (TOOLCHAIN-VERIFIED.md §0): ignored here
#   so it drops out of turbo's `$TURBO_DEFAULT$`, yet still restored via outputs.
#   `bin/` is the Go build output (plan README.md §5) — restorable, not source.
# ---------------------------------------------------------------------------
.cloudflare/
.turbo/
.astro/
.wrangler/
dist/
build/
bin/
coverage/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Linter / tool caches (vale, lychee) and scratch space.
# ---------------------------------------------------------------------------
.vale/
.lycheecache
tmp/
temp/

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/

# ---------------------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
