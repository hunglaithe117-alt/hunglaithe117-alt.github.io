# ---------------------------------------------------------------------------
# Secrets — never commit real values.
#   Source: SOLUTION.md §E; TOOLCHAIN-VERIFIED.md §7; plan README.md §7.
#   `.env.example` is a placeholder and stays tracked.
# ---------------------------------------------------------------------------
.env
.env*
!.env.example
.dev.vars
.dev.vars*
secrets.env
secrets.json
*.pem
*.key

# ---------------------------------------------------------------------------
# Build output / caches.
#   `.cloudflare/` is `cf build` output (TOOLCHAIN-VERIFIED.md §0): ignored here
#   so it drops out of turbo's `$TURBO_DEFAULT$`, yet still restored via outputs.
# ---------------------------------------------------------------------------
.cloudflare/
.turbo/
.astro/
.wrangler/
dist/
build/
coverage/
# Build-generated Open Graph cards (scripts/generate-og.mjs).
apps/web/public/og/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Linter / tool caches (vale, lychee) and scratch space.
# ---------------------------------------------------------------------------
.vale/
.lycheecache
tmp/
temp/

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/

# ---------------------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ---------------------------------------------------------------------------
# Deepwork session state (local only).
# ---------------------------------------------------------------------------
.slim/deepwork/

# ---------------------------------------------------------------------------
# Local-only notes: documentation and doc templates stay on this machine and
# are not published with the site.
# ---------------------------------------------------------------------------
/docs/
/templates/
